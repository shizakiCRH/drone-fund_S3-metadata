    "StartIngestion_DS1": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-west-2:971476708274:function:bedrock_sync_start_ingestion",
      "Parameters": {
        "dataSourceId": "QE8D3XBWTX"
      },
      "ResultPath": "$",
      "Next": "CheckIngestion_DS1"
    },
    "CheckIngestion_DS1": {
      "Type": "Task",
